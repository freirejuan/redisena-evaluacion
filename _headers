# Rediseña.Evaluacion · Cloudflare Pages · headers de caché y seguridad

# ═══════════════════════════════════════════════════
# HTML · caché corta, permite updates rápidos
# ═══════════════════════════════════════════════════
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# ═══════════════════════════════════════════════════
# Assets estáticos · caché larga + immutable
# Cuando cambien, hay que renombrar (styles.v2.css, etc.)
# ═══════════════════════════════════════════════════
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ═══════════════════════════════════════════════════
# Downloads · caché moderada (1 día)
# ═══════════════════════════════════════════════════
/downloads/*
  Cache-Control: public, max-age=86400

# ═══════════════════════════════════════════════════
# Seguridad base para todo el sitio
# ═══════════════════════════════════════════════════
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# La política de arriba es la promesa de privacidad escrita de forma que la
# comprobación no dependa de nuestra buena fe: el navegador impide que esta web
# contacte con ningún dominio ajeno, envíe ningún formulario a ninguna parte o
# cargue ningún recurso de terceros. Desde julio de 2026 no hay ninguno: las
# tipografías y el lector de hojas de cálculo se sirven desde /assets/.
